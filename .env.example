# Server-only AI credentials. Never use NEXT_PUBLIC variables.
# Stay on Workers Free: paid accounts can incur overages.
# Setup: https://developers.cloudflare.com/workers-ai/get-started/rest-api/
AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
# GitHub OAuth: server-only values
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5173/api/github/callback
# 32 random bytes encoded as 64 hex characters
GITHUB_TOKEN_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/google/callback
RESEND_API_KEY=
AUTH_EMAIL_FROM=
APP_ORIGIN=http://localhost:5173
